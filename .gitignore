# === Frozen reference archive — root only, NOT app/wp-content/ ===
# WordPress 7.0.2 core, the stock Divi/Extra/default themes and the uk|ru_RU
# language packs: ~250 MB of vendor code, byte-for-byte recoverable from
# wordpress.org and ElegantThemes. Kept on disk as source material, never pushed.
# The leading slash anchors these to the repo root so the rebuild under
# app/wp-content/ is unaffected.
/wp-admin/
/wp-includes/
/wp-content/

# === Not part of this project ===
# Unrelated "Accurly ERP" monorepo + agent files that were copied in here.
/claude/
